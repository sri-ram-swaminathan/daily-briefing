# --- ElevenLabs (voice in + voice out) ---
ELEVENLABS_API_KEY=
# Narrator voice. Default: "Brian" (deep, calm premade voice). Any voice id from your ElevenLabs library; a script can override it)
ELEVENLABS_VOICE_ID=nPczCjzI2devNFxyxzCm
# Narration model (quality; prefetched so latency is hidden). eleven_v3 also works: tone becomes an audio tag.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Live replies (acks, answers, bridges): lowest latency
ELEVENLABS_TTS_FAST_MODEL=eleven_flash_v2_5
# realtime = Scribe websocket with partial transcripts (best barge-in); batch = one POST per utterance
STT_MODE=realtime
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_BATCH_MODEL=scribe_v2

# --- Data (private Hugging Face Storage Bucket or dataset; see data_store.py) ---
# hf://buckets/<owner>/<bucket>  or  https://huggingface.co/datasets/<owner>/<repo>
HF_DATA_URL=
# Read token for that bucket (on Spaces: a secret). Write token only for tools/upload_data.py.
HF_TOKEN=
# Or read local folders instead (os.pathsep-separated): NEWS_DATA_DIRS=../data/liquid-briefing-data;../data/news-data

# --- OpenAI: the council, the briefing agent, the voice router and research desk ---
OPENAI_API_KEY=
# Models per agent live in models.yaml. OPENAI_MODEL overrides all of them.
# OPENAI_MODEL=gpt-4.1-mini
# Voice-agent-only overrides
# ROUTER_MODEL=gpt-4.1-mini
# MAIN_AGENT_MODEL=gpt-4.1-mini

# --- News Council databases (written by council.py / briefing.py) ---
# COUNCIL_DB=council.sqlite3
# PREFERENCES_DB=preferences.sqlite3

# --- Your own research desk (optional). If set, the voice agent POSTs research requests here. ---
# Contract: voice_agent/main_agent.py docstring. The built-in one is served at /api/main-agent.
MAIN_AGENT_URL=
MAIN_AGENT_TIMEOUT_S=60
# The research desk searches the web (OpenAI web_search) when the feeds fall short. 0 = feeds only.
WEB_SEARCH=1

# --- Website (site/) ---
# Browser origins allowed to call the API, e.g. https://<you>.github.io. Comma-separated; * = any.
CORS_ORIGINS=*
# Feed directories (os.pathsep-separated). Default: liquid-briefing-data and news-data.
# NEWS_DATA_DIRS=

# --- Conversation feel ---
FOLLOWUP_WAIT_S=7
HOLD_LINE_AFTER_S=5

# Dev: silent audio of realistic length, no ElevenLabs calls
FAKE_AUDIO=0
